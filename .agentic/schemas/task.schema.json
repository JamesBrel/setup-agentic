{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskDefinition",
  "description": "Canonical schema for an Agentic Software Factory V3 executable task",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "description",
    "assigned_agent",
    "dependencies",
    "priority",
    "allowed_paths",
    "forbidden_paths",
    "required_inputs",
    "expected_outputs",
    "acceptance_criteria",
    "verification_commands",
    "status",
    "evidence",
    "retry_count",
    "max_retries",
    "risks",
    "handoff_notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9-]+$"
    },
    "workflow_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assigned_agent": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "priority": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "ANALYZED",
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "VERIFYING",
        "ACCEPTED",
        "BLOCKED",
        "REJECTED",
        "CANCELLED"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "verifier", "type", "content_or_path", "passed"],
        "properties": {
          "timestamp": { "type": "string" },
          "verifier": { "type": "string" },
          "type": { "type": "string", "enum": ["COMMAND_OUTPUT", "TEST_RESULTS", "CODE_DIFF", "STATIC_ANALYSIS", "MANUAL_APPROVAL"] },
          "content_or_path": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_retries": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff_notes": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
