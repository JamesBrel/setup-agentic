{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "description": "Canonical schema for an Agentic Software Factory V3 workflow execution pipeline",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "operating_mode",
    "trigger_conditions",
    "required_agents",
    "input_artifacts",
    "execution_stages",
    "quality_gates",
    "failure_handling",
    "completion_criteria",
    "expected_deliverables"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "operating_mode": {
      "type": "string",
      "enum": ["GREENFIELD", "EXISTING_PROJECT", "HYBRID"]
    },
    "trigger_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_agents": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "input_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "execution_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "name", "order", "agent", "execution_mode", "inputs", "outputs", "quality_gate_id"],
        "properties": {
          "stage_id": { "type": "string" },
          "name": { "type": "string" },
          "order": { "type": "integer" },
          "agent": { "type": "string" },
          "execution_mode": { "type": "string", "enum": ["SEQUENTIAL", "PARALLEL"] },
          "parallel_group": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "quality_gate_id": { "type": ["string", "null"] }
        }
      },
      "minItems": 1
    },
    "quality_gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_handling": {
      "type": "object",
      "required": ["retry_limit", "fallback_action", "escalation_target"],
      "properties": {
        "retry_limit": { "type": "integer", "minimum": 1 },
        "fallback_action": { "type": "string" },
        "escalation_target": { "type": "string" }
      }
    },
    "completion_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expected_deliverables": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
