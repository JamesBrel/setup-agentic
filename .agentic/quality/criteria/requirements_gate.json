{
  "gate_id": "GATE-REQ-001",
  "name": "Requirements & PRD Gate",
  "stage": "REQUIREMENTS_ANALYSIS",
  "description": "Certifies that the Product Requirements Document is complete, schema-valid, and actionable.",
  "enforcing_agents": ["requirements-engineer", "prd-architect"],
  "blocking": true,
  "checks": [
    {
      "check_id": "REQ-CHK-01",
      "name": "PRD Schema Validation",
      "category": "REQUIREMENTS_VALIDATION",
      "evaluation_method": "JSON_SCHEMA_CHECK",
      "command": "python -c \"import json, jsonschema; jsonschema.validate(json.load(open('.agentic/memory/prd.json')), json.load(open('.agentic/schemas/prd.schema.json')))\"",
      "required_result": "VALID"
    },
    {
      "check_id": "REQ-CHK-02",
      "name": "Acceptance Criteria Completeness",
      "category": "REQUIREMENTS_VALIDATION",
      "evaluation_method": "ATTRIBUTE_INSPECTION",
      "required_result": "100% functional requirements have Given-When-Then criteria"
    },
    {
      "check_id": "REQ-CHK-03",
      "name": "Out-of-Scope Demarcation",
      "category": "REQUIREMENTS_VALIDATION",
      "evaluation_method": "NON_EMPTY_ARRAY",
      "required_result": "out_of_scope list is populated"
    }
  ],
  "pass_criteria": "All checks return PASS and user signoff artifact is documented.",
  "failure_action": "BLOCK_WORKFLOW"
}
